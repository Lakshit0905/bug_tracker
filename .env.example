# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database ---
POSTGRES_USER=bugtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bugtracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Separate database used by the automated test suite
POSTGRES_TEST_DB=bugtracker_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- First administrator (used by scripts/seed_admin.py) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin1
ADMIN_FULL_NAME=System Administrator

# --- Attachments ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- AI (v2.0) ---
AI_PROVIDER=heuristic          # openai | heuristic | disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=15
AI_DUPLICATE_THRESHOLD=0.80
